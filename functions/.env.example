# Kopiere diese Datei nach functions/.env und trage deine Werte ein.
# Diese Datei ist KEIN Geheimnis-Speicher. Geheimnisse (API Key, Client Secret,
# Session Secret) werden mit `firebase functions:secrets:set` gesetzt.

# OAuth Client ID aus der Google Cloud Console (endet auf .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Nur diese Google-Konten dürfen die App nutzen (kommagetrennt)
ALLOWED_EMAILS=du@gmail.com

# Adresse der PWA auf GitHub Pages (mit Schrägstrich am Ende)
APP_URL=https://ccadrian.github.io/Dienstplan-sync/

# Optional: Modell und Denkaufwand für die Bildanalyse
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=high
